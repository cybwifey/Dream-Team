condition_wide <- condition_tbl %>%\
  filter(\
    person_id %in% person_ids,\
    condition_concept_id %in% condition_ids\
  ) %>%\
  distinct(person_id, condition_concept_id) %>%\
  mutate(has_condition = 1L) %>%\
  collect() %>%\
